  q3 -> q4 [label="CERT-WORD", fontsize=9];
  q4 -> q5 [label="WORD", fontsize=9];
  q5 -> q6 [label="WORD", fontsize=9];
  q6 -> q7 [label="WORD", fontsize=9];
  q8 -> q9 [label="WORD", fontsize=9];
  q9 -> q10 [label="WORD", fontsize=9];
