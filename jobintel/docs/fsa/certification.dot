  start [shape=point]; start -> q0;
  q0 -> q1 [label="PREFIX", fontsize=9];
  q0 -> q8 [label="'certified'", fontsize=9];
  q1 -> q2 [label="PREFIX", fontsize=9];
  q1 -> q4 [label="CERT-WORD", fontsize=9];
  q2 -> q3 [label="PREFIX", fontsize=9];
