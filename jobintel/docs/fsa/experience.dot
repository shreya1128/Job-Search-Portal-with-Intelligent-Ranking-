  q1 -> q4 [label="NUM", fontsize=9];
  q2 -> q1 [label="'least'", fontsize=9];
  q3 -> q1 [label="'to'", fontsize=9];
  q4 -> q5 [label="'+'", fontsize=9];
  q4 -> q6 [label="'-'|'to'", fontsize=9];
  q4 -> q8 [label="YEAR", fontsize=9];
  q5 -> q8 [label="YEAR", fontsize=9];
  q6 -> q7 [label="NUM", fontsize=9];
  q7 -> q5 [label="'+'", fontsize=9];
  q7 -> q8 [label="YEAR", fontsize=9];
  q8 -> q9 [label="'of'", fontsize=9];
  q8 -> q12 [label="EXP", fontsize=9];
  q8 -> q10 [label="'.'", fontsize=9];
  q8 -> q11 [label="apostrophe", fontsize=9];
  q9 -> q12 [label="EXP", fontsize=9];
  q10 -> q12 [label="EXP", fontsize=9];
  q11 -> q12 [label="EXP", fontsize=9];
